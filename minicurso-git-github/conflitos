criar um arquivo na main

echo "Linha original" > arquivo.txt
git add arquivo.txt
git commit -m "Arquivo base criado"


git checkout -b feature-A
echo "Alteração feita pela feature A" > arquivo.txt
git add arquivo.txt
git commit -m "Alteração da feature A"


git checkout main ( volta para main e observe o texto original )


git checkout -b feature-B
echo "Alteração feita pela feature B" > arquivo.txt
git add arquivo.txt
git commit -m "Alteração da feature B"


git checkout main
git merge feature-A ( merge da branch a com a main - sem conflito )

git merge feature-B ( merge da branch b com a main - com conflito )

resolver o conflito manualmente

<<< ( indica o que tem na branch )
>>> ( indica o que vai entrar na branch com o merge que gerou o conflito )

git add arquivo.txt
git commit -m "Resolve conflito entre feature-A e feature-B"


